{
  "id": "rpg-task-manager",
  "realm": "rpg-task-manager",
  "displayName": "RPG Task Manager",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,

  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 5184000,

  "defaultRole": {
    "name": "player",
    "description": "Роль по умолчанию для всех новых пользователей"
  },

  "roles": {
    "realm": [
      {
        "name": "player",
        "description": "Обычный игрок"
      },
      {
        "name": "admin",
        "description": "Администратор системы"
      },
      {
        "name": "moderator",
        "description": "Модератор"
      }
    ]
  },

  "clients": [
    {
      "clientId": "backend-api",
      "name": "Backend API",
      "description": "Конфиденциальный клиент для всех backend-сервисов",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6",
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "realm_roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": true
          }
        }
      ]
    },
    {
      "clientId": "mobile-app",
      "name": "Mobile Application",
      "description": "Публичный клиент для мобильного приложения (Authorization Code + PKCE)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "myrpgapp://callback",
        "http://localhost:3000/callback"
      ],
      "webOrigins": ["+"]
    }
  ],

  "users": [
    {
      "username": "testplayer",
      "email": "testplayer@example.com",
      "firstName": "Test",
      "lastName": "Player",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "test123!",
          "temporary": false
        }
      ],
      "realmRoles": ["player"]
    },
    {
      "username": "adminplayer",
      "email": "admin@example.com",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123!",
          "temporary": false
        }
      ],
      "realmRoles": ["player", "admin"]
    }
  ]
}